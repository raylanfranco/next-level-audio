# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep the documented template)
.env*
!.env.example

# vercel
.vercel/

# product image cache (allow product-images.json for Vercel deployment)
/data/*
!/data/product-images.json
!/data/reviews.json

# typescript
*.tsbuildinfo
next-env.d.ts

# BayReady (separate repo, lives here during development)
/bayready/
/bayready-ui-revamp/

# Internal docs (strategy, playbooks — not for public repo)
/docs/

# Misc dev artifacts
dashboard.png
nul
context.md
ROADMAP.md
.claude/settings.json
.claude/settings.local.json

# Variant design exports for V2 revamp — deletable once V2 is live
/variant-designs/

# Supabase CLI local cache
supabase/.temp/
