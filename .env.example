# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Clover inventory and ecommerce (required for catalog/checkout)
CLOVER_API_BASE_URL=https://api.clover.com
CLOVER_API_TOKEN=your-clover-api-token
CLOVER_MERCHANT_ID=your-clover-merchant-id
CLOVER_ECOMM_PUBLIC_KEY=your-clover-public-key
CLOVER_ECOMM_PRIVATE_KEY=your-clover-private-key
CLOVER_CHARGE_ENV=sandbox
NEXT_PUBLIC_CLOVER_MERCHANT_ID=your-clover-merchant-id

# Who's Next booking integration
WHOS_NEXT_API_URL=https://whos-next-production.up.railway.app
WHOS_NEXT_MERCHANT_ID=your-whos-next-merchant-id
WHOS_NEXT_SERVICE_KEY=generate-a-random-secret-at-least-32-characters-long
NEXT_PUBLIC_WHOS_NEXT_API_URL=https://whos-next-production.up.railway.app

# Stripe VIP membership
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_VIP_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional integrations
OPENAI_API_KEY=
NEXT_PUBLIC_AI_CHAT_ENABLED=false
RESEND_API_KEY=
